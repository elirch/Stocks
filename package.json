{
  "name": "portfolio-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio Atlas by Theta23 — turn your holdings into an explorable infographic.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
