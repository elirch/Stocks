# Portfolio Atlas — example environment. Copy to .env.local for local development.
# Never commit real secrets. None of these are required to run the app.

# Which security-metadata provider powers search on the server.
#   none     — search disabled; manual entry only (safe default for production)
#   fixture  — small built-in demo dataset, clearly labelled as demo data in the UI
#   openfigi — OpenFIGI search API (verify current terms before enabling publicly)
MARKET_DATA_PROVIDER=fixture

# Optional OpenFIGI API key (server-side only; raises rate limits). Leave empty to use anonymous limits.
OPENFIGI_API_KEY=
